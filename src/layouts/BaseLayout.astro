---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";
import SkipLink from "@/components/Global/SkipLink.astro";
import Nav from "@/components/Global/Nav.astro";
import Footer from "@/components/Global/Footer.astro";
import GlobalContact from "@/components/Sections/GlobalContact.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  name: "Accountstar",
  url: "https://www.accountstar.co.uk",
  email: "admin@accountstar.co.uk",
  description:
    "Professional accounting and tax services for small businesses, founders and non-profit organisations.",
  areaServed: "United Kingdom",
};
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <GlobalContact />
    <Footer />
  </body>
</html>
