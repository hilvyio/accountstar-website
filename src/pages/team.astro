import PageHero from "@/components/Sections/PageHero.astro";
import TeamProfiles from "@/components/Sections/TeamProfiles.astro";
import ContactCta from "@/components/Sections/ContactCta.astro";
---

<Layout
  title="Meet the team"
  description="Meet the experienced Accountstar team supporting small businesses with day-to-day accounting and tax issues."
>
