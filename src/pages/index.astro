---
import Layout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/Sections/HomeHero.astro";
import LogoStrip from "@/components/Sections/LogoStrip.astro";
import ServiceCards from "@/components/Sections/ServiceCards.astro";
import ContactCta from "@/components/Sections/ContactCta.astro";
import Section from "@/components/Wrapper/Section.astro";
import Img from "@/components/Media/Img.astro";
import stellaOffice from "@/assets/images/stella-office.jpg";
import { MISSION } from "@/data/site.ts";
---

<Layout
  title="Accounting and tax services"
  description="Professional and affordable accounting and tax services for sole traders, limited companies, charities and CICs."
>
  <HomeHero />
  <LogoStrip />
  <ServiceCards />

  <Section class="home-about_wrap">
    <div class="home-about_grid">
      <div class="home-about_visual">
        <Img src={stellaOffice} alt="Stella Ezeogu working in the Accountstar office" width={1000} height={1100} />
      </div>
      <div class="home-about_copy">
        <span class="section_rule" aria-hidden="true"></span>
        <p class="home-about_kicker">I am here to help you understand your numbers</p>
        <h2>Accounting support that makes business feel simpler.</h2>
        <p class="home-about_lead">{MISSION}</p>
        <p>
          Accountstar was formed to serve small businesses and new entrepreneurs from diverse backgrounds. We provide affordable, professional accounting services and make tax obligations and statutory requirements easy to understand.
        </p>
        <a class="text_link" href="/about-us">More about Accountstar <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </Section>

  <ContactCta
    heading="Need something personalised?"
    text="Tell us what you need and we will help you find the right accounting support."
  />
</Layout>

<style is:global>
  @layer components {
    .home-about_grid { display: grid; gap: clamp(3rem, 8vw, 8rem); align-items: center; }
    .home-about_visual { min-height: 34rem; }
    .home-about_visual .image { width: 100%; height: 100%; min-height: 34rem; object-position: center 20%; }
    .home-about_copy { display: flex; flex-direction: column; align-items: flex-start; }
    .section_rule { display: block; width: 4rem; height: .25rem; margin-bottom: 1.75rem; background: var(--brand-500); }
    .home-about_kicker { margin-bottom: 1rem; color: var(--brand-500); font-size: 1rem; font-weight: 700; }
    .home-about_copy h2 { max-width: 11em; font-weight: 500; }
    .home-about_copy p { max-width: 40rem; margin-top: 1.4rem; color: var(--dark-700); }
    .home-about_copy .home-about_lead { color: var(--dark-900); font-size: 1.15rem; }
    .text_link { margin-top: 2rem; padding-bottom: .3rem; border-bottom: 1px solid var(--brand-500); color: var(--brand-500); font-weight: 700; }
    @media (width >= 64rem) { .home-about_grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); } }
  }
</style>
