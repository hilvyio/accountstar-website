---
import Layout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/Sections/PageHero.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Img from "@/components/Media/Img.astro";
import resourcesHero from "@/assets/images/resources-hero.jpg";
---

<Layout
  title="Resources"
  description="Free practical accounting resources from Accountstar, including a financial planning template."
>
  <PageHero
    eyebrow="Free tools"
    title="Resources"
    description="Practical resources to help you organise your finances and make better-informed business decisions."
    image={resourcesHero}
    imageAlt="Person working on a financial plan"
    primaryLabel="Request the template"
    primaryHref="mailto:admin@accountstar.co.uk?subject=Financial%20Plan%20Template%20request"
  />
  <Section>
    <ContentWrapper variant="contain">
      <Eyebrow>Free download</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={16}>
        Financial plan template
      </Heading>
      <Paragraph variant="large" maxWidth={42}>
        Build a clearer view of your goals, costs and next steps with our free
        financial planning template.
      </Paragraph>
      <Paragraph maxWidth={46}>
        Email us to request your copy and the Accountstar team will send it
        directly to you.
      </Paragraph>
      <ButtonWrapper>
        <Button
          element="link"
          href="mailto:admin@accountstar.co.uk?subject=Financial%20Plan%20Template%20request"
        >
          Request by email
        </Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={resourcesHero}
        alt="Financial planning notes and calculator"
        width={1000}
        height={900}
      />
    </ContentWrapper>
  </Section>
</Layout>
