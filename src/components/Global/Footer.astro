---
import Img from "@/components/Media/Img.astro";
import logo from "@/assets/images/accountstar-logo.png";
import { CONTACT, services } from "@/data/site.ts";
import { SITE_NAME } from "@/consts.ts";

interface Props { render?: boolean; }
const { render = true } = Astro.props;
---

{render && (
  <footer class="footer_wrap">
    <div class="footer_inner">
      <div class="footer_intro">
        <a class="footer_logo" href="/" aria-label={`${SITE_NAME} home`}>
          <Img src={logo} alt="" width={220} height={77} transparent={true} />
        </a>
        <p>Accountstar was formed to serve small businesses and new entrepreneurs from diverse backgrounds.</p>
      </div>

      <nav aria-label="Company">
        <strong>Menu</strong>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about-us">About us</a></li>
          <li><a href="/team">Meet the team</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/reviews">Reviews</a></li>
          <li><a href="/contact-us">Contact us</a></li>
        </ul>
      </nav>

      <nav aria-label="Services">
        <strong>Services</strong>
        <ul>
          {services.map((service) => <li><a href={service.href}>{service.name}</a></li>)}
        </ul>
      </nav>

      <div class="footer_contact">
        <strong>Contact</strong>
        <ul>
          <li><a href={CONTACT.emailHref}>{CONTACT.email}</a></li>
          <li><a href={CONTACT.whatsapp} target="_blank" rel="noreferrer">WhatsApp</a></li>
          <li><a href={CONTACT.calendly} target="_blank" rel="noreferrer">Book a free chat</a></li>
        </ul>
      </div>
    </div>
    <div class="footer_bottom">
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}</p>
      <p>Website by <a href="https://derrick.dk" target="_blank" rel="noreferrer">Derrick.dk</a></p>
    </div>
  </footer>
)}

<style is:global>
  @layer components {
    .footer_wrap { padding: var(--section-space-small) var(--site-margin) var(--space-5); background: var(--brand-500); color: white; }
    .footer_inner { display: grid; max-width: var(--max-width-main); margin-inline: auto; gap: var(--space-7); }
    .footer_intro { max-width: 26rem; }
    .footer_logo { display: block; width: 10rem; margin-bottom: 1.5rem; padding: .6rem; background: white; }
    .footer_intro p { color: rgb(255 255 255 / 76%); }
    .footer_wrap strong { display: block; margin-bottom: 1rem; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; }
    .footer_wrap ul { display: grid; gap: .55rem; color: rgb(255 255 255 / 76%); font-size: .92rem; }
    .footer_wrap a:hover { color: white; text-decoration: underline; }
    .footer_bottom { display: flex; max-width: var(--max-width-main); margin: var(--space-7) auto 0; padding-top: var(--space-4); flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; border-top: 1px solid rgb(255 255 255 / 24%); color: rgb(255 255 255 / 70%); font-size: .84rem; }
    @media (width >= 48rem) { .footer_inner { grid-template-columns: 2fr 1fr 1fr; } .footer_contact { grid-column: 2 / -1; } }
    @media (width >= 64rem) { .footer_inner { grid-template-columns: 2.2fr 1fr 1.35fr 1.3fr; } .footer_contact { grid-column: auto; } }
  }
</style>
