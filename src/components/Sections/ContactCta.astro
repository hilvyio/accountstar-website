---
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import { CONTACT } from "@/data/site.ts";

interface Props {
  render?: boolean;
  heading?: string;
  text?: string;
}

const {
  render = true,
  heading = "Need something more personal?",
  text = "Tell us what you are working on. A free 15-minute chat is often the quickest way to find the right next step.",
} = Astro.props;
---

{
  render && (
    <Section theme="brand" class="contact-cta_wrap">
      <ContentWrapper variant="auto-width">
        <div>
          <Eyebrow>Let's talk</Eyebrow>
          <Heading tag="h2" variant="h2" maxWidth={15}>
            {heading}
          </Heading>
          <Paragraph variant="large" maxWidth={42}>
            {text}
          </Paragraph>
        </div>
        <ButtonWrapper slot="column2">
          <Button
            element="link"
            href={CONTACT.calendly}
            target="_blank"
            rel="noreferrer"
          >
            Book a free chat
          </Button>
          <Button element="link" href={CONTACT.emailHref} emphasis="secondary">
            Email us
          </Button>
        </ButtonWrapper>
      </ContentWrapper>
    </Section>
  )
}

<style is:global>
  @layer components {
    .contact-cta_wrap {
      background-image:
        radial-gradient(
          circle at 88% 20%,
          color-mix(in srgb, var(--purple-500) 38%, transparent) 0,
          transparent 24rem
        ),
        linear-gradient(120deg, var(--brand-500), var(--gold-400));
    }
  }
</style>
